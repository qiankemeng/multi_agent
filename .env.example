# ========================================================================
# Multi-Agent Long Video Understanding System - Configuration
# ========================================================================
#
# 本文件只包含系统级全局配置
# 所有业务参数（如帧数、分段时长、温度等）应在调用时动态传递
#
# ========================================================================

# ==================== MLLM API配置 ====================

# OpenAI API配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4-vision-preview
OPENAI_ORGANIZATION_ID=

# Claude API配置（未来支持）
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_DEFAULT_MODEL=claude-3-opus-20240229

# Gemini API配置（未来支持）
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_DEFAULT_MODEL=gemini-pro-vision

# ==================== API行为配置 ====================

# 请求超时时间（秒）
MLLM_REQUEST_TIMEOUT=60

# 最大重试次数
MLLM_MAX_RETRIES=3

# 重试延迟（秒）
MLLM_RETRY_DELAY=1.0

# ==================== 成本控制 ====================

# 价格（美元/1K tokens）
OPENAI_PRICE_PROMPT_1K=0.01
OPENAI_PRICE_COMPLETION_1K=0.03

# 单次请求最大成本限制（美元，0表示不限制）
MAX_REQUEST_COST=0

# 每日最大成本限制（美元，0表示不限制）
MAX_DAILY_COST=0

# ==================== 数据存储配置 ====================

# 数据目录
DATA_DIR=./data
VIDEO_DIR=./data/videos
OUTPUT_DIR=./data/output
CACHE_DIR=./data/cache
TEMP_DIR=./data/temp

# ==================== 日志配置 ====================

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_TO_CONSOLE=true

# ==================== 性能配置 ====================

# 并发请求数
MAX_CONCURRENT_REQUESTS=3

# 启用缓存
ENABLE_CACHE=true

# 缓存过期时间（秒）
CACHE_EXPIRY=3600

# ==================== 环境配置 ====================

# 环境模式 (development, production, testing)
ENVIRONMENT=development

# 是否启用调试模式
DEBUG=false

# 是否启用模拟模式（不实际调用API）
MOCK_MODE=false

# Python版本要求
PYTHON_VERSION=3.12
